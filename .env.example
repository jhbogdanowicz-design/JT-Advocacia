# =========================================================================
# CONFIGURAÇÃO DE VARIÁVEIS DE AMBIENTE - JT ADVOCACIA
# Copie este arquivo para um novo arquivo chamado ".env" e insira sua chave
# =========================================================================

# Variáveis de Conexão do Supabase (Frontend)
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua_chave_anonima_aqui

# Chave secreta da API do Google Gemini (gemini-2.5-flash)
# Obtenha uma chave em: https://aistudio.google.com/
GOOGLE_API_KEY=sua_chave_do_gemini_aqui
